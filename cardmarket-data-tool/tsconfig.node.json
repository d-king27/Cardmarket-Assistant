{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mjs",
    "server/cardmarketJobRoute.ts",
    "server/cardmarketJobStore.ts",
    "server/cardmarketJobStore.test.ts",
    "src/cardmarket/**/*.ts",
    "src/models/**/*.ts"
  ]
}
